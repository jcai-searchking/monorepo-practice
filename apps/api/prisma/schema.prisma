generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
    ADMIN
    HOST
    PLAYER
}
enum SkillLevel {
  OPEN
  INTERMEDIATE
  INTERMEDIATE_PLUS
}

enum GenderFormat {
  MENS
  WOMENS
  COED
}


// --- The People ---
model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String?
  name          String
  birthDate     DateTime?     @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  refreshTokens RefreshToken[]
  role          Role          @default(PLAYER)
  lobbies       Lobby[]       @relation("HostedLobbies")
  googleSub     String?       @unique
  pictureUrl    String?       
}

// --- The Games ---
model Lobby {
  id            String        @id @default(uuid())
  lobbyName     String
  location      String
  startTime     DateTime
  endTime       DateTime
  price         Float
  skillLevel    SkillLevel
  genderFormat  GenderFormat
  allowToApply  Boolean
  createdAt     DateTime      @default(now())
  hostId        String
  host          User          @relation("HostedLobbies", fields: [hostId], references: [id])
}

model RefreshToken {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique
  userId      String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
